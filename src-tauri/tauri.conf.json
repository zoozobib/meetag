{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rec",
  "version": "0.1.0",
  "identifier": "com.zoozobib.rec",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tauri",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
     "resources": [
        "resources/ggml-small.bin",
        "resources/silero_vad.onnx",
        "resources/sherpa-onnx-pyannote-segmentation-3-0-model.int8.onnx",
        "resources/speaker_embedding/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx",
        "resources/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/model.int8.onnx",
        "resources/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/tokens.txt",
        "libonnxruntime.1.17.1.dylib",
        "libsherpa-onnx-c-api.dylib"
      ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}